FROM python:3.12-slim AS base

WORKDIR /app

RUN pip install uv

COPY pyproject.toml uv.lock* ./
COPY packages/ packages/
COPY apps/api/ apps/api/
COPY services/ services/
COPY migrations/ migrations/

RUN uv sync --all-packages

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/apps/api/src:/app/packages/schemas/src:/app/packages/database/src:/app/packages/messaging/src:/app/packages/observability/src:/app/packages/source-licensing/src:/app/packages/model-client/src"

EXPOSE 8000

CMD ["uvicorn", "mip_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
